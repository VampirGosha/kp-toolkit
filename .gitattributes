# Нормализуем текстовые файлы к LF в репозитории,
# чтобы на Windows не было шумных warnings и лишних дифов.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf